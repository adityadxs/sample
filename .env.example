# Application Configuration
APP_NAME=Beverage Bottle Vision & Continual Learning System
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# Security & Limits
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=["jpg", "jpeg", "png", "webp"]

# Database
DATABASE_URL=sqlite:///./data/app.db

# Storage Paths
DATA_DIR=./data
RAW_IMAGE_DIR=./data/raw
CROP_IMAGE_DIR=./data/crops
TRAINING_DATA_DIR=./data/training
REPLAY_BUFFER_DIR=./data/replay
VALIDATION_DATA_DIR=./data/validation
MODEL_DIR=./models/versions

# Confidence & Review Thresholds
DETECTION_CONFIDENCE_THRESHOLD=0.40
CLASSIFICATION_HIGH_CONFIDENCE=0.90
CLASSIFICATION_REVIEW_THRESHOLD=0.50
CONFIDENCE_MARGIN_THRESHOLD=0.15

# Continual Learning & Replay Buffer
TRAINING_MIN_NEW_SAMPLES=10
REPLAY_BUFFER_SIZE=500
REPLAY_SAMPLES_PER_CLASS=20
INCREMENTAL_BATCH_SIZE=32
LEARNING_RATE=0.0005

# Catastrophic Forgetting Thresholds
MAX_OLD_SKU_ACCURACY_DROP=0.05
MIN_NEW_SKU_ACCURACY=0.75
